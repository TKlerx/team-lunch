# nosemgrep: package_managers.npm.npm-missing-minimum-release-age.npm-missing-minimum-release-age -- pnpm policy is in pnpm-workspace.yaml
# Skip the pre-run dependency status check (build-script approval for native
# deps is declared in pnpm-workspace.yaml allowBuilds); the check otherwise
# aborts `pnpm run` scripts.
verify-deps-before-run=false
