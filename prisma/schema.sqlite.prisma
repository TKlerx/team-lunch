generator client {
  provider = "prisma-client-js"
  output   = "../src/server/generated/sqlite-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model OfficeLocation {
  id                                 String           @id @default(uuid())
  key                                String           @unique
  name                               String           @unique
  isActive                           Boolean          @default(true) @map("is_active")
  autoStartPollEnabled               Boolean          @default(false) @map("auto_start_poll_enabled")
  autoStartPollWeekdays              Json             @default("[]") @map("auto_start_poll_weekdays")
  autoStartPollFinishTime            String?          @map("auto_start_poll_finish_time")
  defaultFoodSelectionDurationMinutes Int             @default(30) @map("default_food_selection_duration_minutes")
  createdAt                          DateTime         @default(now()) @map("created_at")
  updatedAt                          DateTime         @updatedAt @map("updated_at")
  authAccessUsers   AuthAccessUser[]
  authAccessUserOffices AuthAccessUserOffice[]
  menus             Menu[]
  menuItemIdentities MenuItemIdentity[]
  menuItemFeatures  MenuItemFeature[]
  userAnticipatedLikes UserAnticipatedLike[]
  modelEvaluationResults ModelEvaluationResult[]
  officeRecommenderSetting OfficeRecommenderSetting?
  polls             Poll[]
  foodSelections    FoodSelection[]
  shoppingListItems ShoppingListItem[]
  mealRecommendationImpressions MealRecommendationImpression[]

  @@map("office_locations")
}

model Menu {
  id                String          @id @default(uuid())
  officeLocationId  String          @map("office_location_id")
  name              String
  location          String?
  phone             String?
  url               String?
  orderUrl          String?         @map("order_url")
  sourceDateCreated DateTime?       @map("source_date_created")
  createdAt         DateTime        @default(now()) @map("created_at")
  items             MenuItem[]
  pollVotes         PollVote[]
  pollExclusions    PollExcludedMenu[]
  wonPolls          Poll[]          @relation("WinnerMenu")
  foodSelections    FoodSelection[]
  userMealDefaults  UserMenuDefaultPreference[]
  officeLocation    OfficeLocation  @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)

  @@unique([officeLocationId, name])
  @@map("menus")
}

model MenuItem {
  id          String      @id @default(uuid())
  menuId      String      @map("menu_id")
  itemIdentityKey String? @map("item_identity_key")
  itemNumber  String?     @map("item_number")
  name        String
  description String?
  price       Decimal?
  createdAt   DateTime    @default(now()) @map("created_at")
  menu        Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuItemFeatures MenuItemFeature[]
  foodOrders  FoodOrder[]
  userMealDefaults UserMenuDefaultPreference[]

  @@unique([menuId, name])
  @@map("menu_items")
}

model MenuItemIdentity {
  id                  String   @id @default(uuid())
  officeLocationId    String   @map("office_location_id")
  identityKey         String   @map("identity_key")
  displayNameSnapshot String   @map("display_name_snapshot")
  createdAt           DateTime @default(now()) @map("created_at")

  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)

  @@unique([officeLocationId, identityKey])
  @@map("menu_item_identities")
}

model MenuItemFeature {
  id               String   @id @default(uuid())
  menuItemId       String   @map("menu_item_id")
  itemIdentityKey  String   @map("item_identity_key")
  officeLocationId String   @map("office_location_id")
  tag              String
  provenance       String
  createdAt        DateTime @default(now()) @map("created_at")

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, tag])
  @@index([itemIdentityKey, officeLocationId])
  @@map("menu_item_features")
}

model Poll {
  id                     String          @id @default(uuid())
  officeLocationId       String          @map("office_location_id")
  createdBy              String?         @map("created_by")
  description            String
  status                 String
  startedAt              DateTime        @map("started_at")
  endsAt                 DateTime        @map("ends_at")
  endedPrematurely       Boolean         @default(false) @map("ended_prematurely")
  winnerMenuId           String?         @map("winner_menu_id")
  winnerMenuName         String?         @map("winner_menu_name")
  winnerSelectedRandomly Boolean         @default(false) @map("winner_selected_randomly")
  createdAt              DateTime        @default(now()) @map("created_at")
  officeLocation         OfficeLocation  @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)
  winnerMenu             Menu?           @relation("WinnerMenu", fields: [winnerMenuId], references: [id], onDelete: SetNull)
  votes                  PollVote[]
  excludedMenus          PollExcludedMenu[]
  foodSelections         FoodSelection[]

  @@index([officeLocationId, status])
  @@map("polls")
}

model PollExcludedMenu {
  id        String   @id @default(uuid())
  pollId    String   @map("poll_id")
  menuId    String   @map("menu_id")
  menuName  String   @map("menu_name")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@unique([pollId, menuId])
  @@map("poll_excluded_menus")
}

model PollVote {
  id       String   @id @default(uuid())
  pollId   String   @map("poll_id")
  menuId   String   @map("menu_id")
  menuName String   @map("menu_name")
  nickname String
  actorKey String?  @map("actor_key")
  actorEmail String? @map("actor_email")
  displayNameSnapshot String? @map("display_name_snapshot")
  castAt   DateTime @default(now()) @map("cast_at")
  poll     Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  menu     Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([pollId, menuId, actorKey])
  @@map("poll_votes")
}

model FoodSelection {
  id               String         @id @default(uuid())
  officeLocationId String         @map("office_location_id")
  createdBy        String?        @map("created_by")
  pollId           String         @map("poll_id")
  menuId           String?        @map("menu_id")
  menuName         String         @map("menu_name")
  status           String
  startedAt        DateTime       @map("started_at")
  endsAt           DateTime       @map("ends_at")
  orderPlacedAt    DateTime?      @map("order_placed_at")
  orderPlacedBy    String?        @map("order_placed_by")
  completedAt      DateTime?      @map("completed_at")
  etaMinutes       Int?           @map("eta_minutes")
  etaSetAt         DateTime?      @map("eta_set_at")
  deliveryDueAt    DateTime?      @map("delivery_due_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  officeLocation   OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)
  poll             Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  menu             Menu?          @relation(fields: [menuId], references: [id], onDelete: SetNull)
  orders           FoodOrder[]
  recommendationImpressions MealRecommendationImpression[]

  @@index([officeLocationId, status, createdAt])
  @@map("food_selections")
}

model RecommenderModel {
  id                  String   @id @default(uuid())
  version             Int      @unique
  status              String
  paramsJson          Json     @map("params_json")
  factorDim           Int      @map("factor_dim")
  trainedAt           DateTime @map("trained_at")
  trainingSampleCount Int      @map("training_sample_count")
  createdAt           DateTime @default(now()) @map("created_at")

  mealRecommendationImpressions MealRecommendationImpression[]
  modelEvaluationResults        ModelEvaluationResult[]
  officeRecommenderSettings     OfficeRecommenderSetting[]

  @@index([status])
  @@map("recommender_models")
}

model ModelEvaluationResult {
  id                 String   @id @default(uuid())
  recommenderModelId String   @map("recommender_model_id")
  officeLocationId   String   @map("office_location_id")
  baselineTop3HitRate Decimal  @map("baseline_top3_hit_rate")
  modelTop3HitRate   Decimal  @map("model_top3_hit_rate")
  marginPoints       Decimal  @map("margin_points")
  sampleCount        Int      @map("sample_count")
  evaluatedAt        DateTime @default(now()) @map("evaluated_at")

  recommenderModel RecommenderModel @relation(fields: [recommenderModelId], references: [id], onDelete: Cascade)
  officeLocation   OfficeLocation   @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)

  @@index([officeLocationId, recommenderModelId])
  @@map("model_evaluation_results")
}

model OfficeRecommenderSetting {
  id              String   @id @default(uuid())
  officeLocationId String   @unique @map("office_location_id")
  safeMode        String   @default("baseline") @map("safe_mode")
  activeModelId    String?  @map("active_model_id")
  exploreEnabled   Boolean  @default(true) @map("explore_enabled")
  updatedAt        DateTime @updatedAt @map("updated_at")

  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)
  activeModel    RecommenderModel? @relation(fields: [activeModelId], references: [id], onDelete: SetNull)

  @@map("office_recommender_settings")
}

model FoodOrder {
  id              String        @id @default(uuid())
  selectionId     String        @map("selection_id")
  nickname        String
  actorKey        String?       @map("actor_key")
  actorEmail      String?       @map("actor_email")
  displayNameSnapshot String?   @map("display_name_snapshot")
  itemId          String?       @map("item_id")
  itemName        String        @map("item_name")
  notes           String?
  feedbackComment String?       @map("feedback_comment")
  processed       Boolean       @default(false)
  processedAt     DateTime?     @map("processed_at")
  delivered       Boolean       @default(false)
  deliveredAt     DateTime?     @map("delivered_at")
  rating          Int?
  ratedAt         DateTime?     @map("rated_at")
  orderedAt       DateTime      @default(now()) @map("ordered_at")
  selection       FoodSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  item            MenuItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("food_orders")
}

model LocalAuthUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("local_auth_users")
}

model AuthAccessUser {
  id               String          @id @default(uuid())
  email            String          @unique
  displayName      String?         @map("display_name")
  displayNameSource String?        @map("display_name_source")
  sessionVersion   Int             @default(0) @map("session_version")
  approved         Boolean         @default(false)
  isAdmin          Boolean         @default(false) @map("is_admin")
  blocked          Boolean         @default(false)
  officeLocationId String?         @map("office_location_id")
  requestedAt      DateTime        @default(now()) @map("requested_at")
  approvedAt       DateTime?       @map("approved_at")
  blockedAt        DateTime?       @map("blocked_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  officeLocation OfficeLocation? @relation(fields: [officeLocationId], references: [id], onDelete: SetNull)
  officeMemberships AuthAccessUserOffice[]

  @@map("auth_access_users")
}

model AuthAccessUserOffice {
  id               String          @id @default(uuid())
  authAccessUserId String          @map("auth_access_user_id")
  officeLocationId String          @map("office_location_id")
  createdAt        DateTime        @default(now()) @map("created_at")

  authAccessUser AuthAccessUser @relation(fields: [authAccessUserId], references: [id], onDelete: Cascade)
  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)

  @@unique([authAccessUserId, officeLocationId])
  @@index([officeLocationId])
  @@map("auth_access_user_offices")
}

model AuditLog {
  id         String   @id @default(uuid())
  event      String
  actorEmail String?  @map("actor_email")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId], map: "audit_logs_target_idx")
  @@map("audit_logs")
}

model AuthAuditLog {
  id          String   @id @default(uuid())
  event       String
  actorEmail  String?  @map("actor_email")
  targetEmail String?  @map("target_email")
  targetType  String   @default("auth_user") @map("target_type")
  field       String?
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([targetEmail, createdAt], map: "auth_audit_logs_target_email_idx")
  @@index([event, createdAt], map: "auth_audit_logs_event_idx")
  @@map("auth_audit_logs")
}

model UserPreference {
  id            String   @id @default(uuid())
  userKey       String   @unique @map("user_key")
  allergiesJson Json     @default("[]") @map("allergies_json")
  dislikesJson  Json     @default("[]") @map("dislikes_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model UserAnticipatedLike {
  id                  String   @id @default(uuid())
  actorKey            String   @map("actor_key")
  actorEmail          String?  @map("actor_email")
  displayNameSnapshot String?  @map("display_name_snapshot")
  officeLocationId    String   @map("office_location_id")
  itemIdentityKey     String   @map("item_identity_key")
  itemNameSnapshot    String   @map("item_name_snapshot")
  sentiment           String
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)

  @@unique([actorKey, officeLocationId, itemIdentityKey])
  @@map("user_anticipated_likes")
}

model UserMenuDefaultPreference {
  id                     String   @id @default(uuid())
  userKey                String   @map("user_key")
  menuId                 String   @map("menu_id")
  itemId                 String   @map("item_id")
  defaultComment         String?  @map("default_comment")
  allowOrganizerFallback Boolean  @default(false) @map("allow_organizer_fallback")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userKey, menuId])
  @@map("user_menu_default_preferences")
}

model MealRecommendationImpression {
  id                  String   @id @default(uuid())
  foodSelectionId     String   @map("food_selection_id")
  officeLocationId    String   @map("office_location_id")
  actorKey            String   @map("actor_key")
  actorEmail          String?  @map("actor_email")
  displayNameSnapshot String?  @map("display_name_snapshot")
  source              String
  provider            String?
  recommenderModelId  String?  @map("recommender_model_id")
  recommendedAt       DateTime @map("recommended_at")
  inputSummaryJson    Json     @map("input_summary_json")
  itemsJson           Json     @map("items_json")
  createdAt           DateTime @default(now()) @map("created_at")

  foodSelection  FoodSelection  @relation(fields: [foodSelectionId], references: [id], onDelete: Cascade)
  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)
  recommenderModel RecommenderModel? @relation(fields: [recommenderModelId], references: [id], onDelete: SetNull)

  @@index([foodSelectionId, actorKey])
  @@index([officeLocationId, actorKey, recommendedAt])
  @@map("meal_recommendation_impressions")
}

model ShoppingListItem {
  id          String   @id @default(uuid())
  officeLocationId String @map("office_location_id")
  name        String
  requestedBy String   @map("requested_by")
  bought      Boolean  @default(false)
  boughtBy    String?  @map("bought_by")
  boughtAt    DateTime? @map("bought_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)

  @@index([officeLocationId, bought, createdAt])
  @@map("shopping_list_items")
}
