generator client {
  provider            = "prisma-client"
  output              = "../src/server/generated/client"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model OfficeLocation {
  id                                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                                String   @unique @db.VarChar(40)
  name                               String   @unique @db.VarChar(80)
  isActive                           Boolean  @default(true) @map("is_active")
  autoStartPollEnabled               Boolean  @default(false) @map("auto_start_poll_enabled")
  autoStartPollWeekdays              Json     @default("[]") @map("auto_start_poll_weekdays")
  autoStartPollFinishTime            String?  @map("auto_start_poll_finish_time") @db.VarChar(5)
  defaultFoodSelectionDurationMinutes Int     @default(30) @map("default_food_selection_duration_minutes")
  createdAt                          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                          DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  authAccessUsers   AuthAccessUser[]
  authAccessUserOffices AuthAccessUserOffice[]
  menus             Menu[]
  menuItemIdentities MenuItemIdentity[]
  menuItemFeatures  MenuItemFeature[]
  userAnticipatedLikes UserAnticipatedLike[]
  modelEvaluationResults ModelEvaluationResult[]
  officeRecommenderSetting OfficeRecommenderSetting?
  polls             Poll[]
  foodSelections    FoodSelection[]
  shoppingListItems ShoppingListItem[]
  mealRecommendationImpressions MealRecommendationImpression[]

  @@map("office_locations")
}

model Menu {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeLocationId String @map("office_location_id") @db.Uuid
  name      String   @db.VarChar(60)
  location  String?  @db.VarChar(160)
  phone     String?  @db.VarChar(40)
  url       String?  @db.VarChar(255)
  orderUrl  String?  @map("order_url") @db.VarChar(255)
  sourceDateCreated DateTime? @map("source_date_created") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  items       MenuItem[]
  pollVotes   PollVote[]
  pollExclusions PollExcludedMenu[]
  wonPolls    Poll[]          @relation("WinnerMenu")
  foodSelections FoodSelection[]
  userMealDefaults UserMenuDefaultPreference[]
  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)

  @@unique([officeLocationId, name])
  @@map("menus")
}

model MenuItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuId      String   @map("menu_id") @db.Uuid
  itemIdentityKey String? @map("item_identity_key") @db.VarChar(120)
  itemNumber  String?  @map("item_number") @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(200)
  price       Decimal? @db.Decimal(8, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  menu       Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuItemFeatures MenuItemFeature[]
  foodOrders FoodOrder[]
  userMealDefaults UserMenuDefaultPreference[]

  @@unique([menuId, name])
  @@map("menu_items")
}

model MenuItemIdentity {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeLocationId    String   @map("office_location_id") @db.Uuid
  identityKey         String   @map("identity_key") @db.VarChar(120)
  displayNameSnapshot String   @map("display_name_snapshot") @db.VarChar(80)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)

  @@unique([officeLocationId, identityKey])
  @@map("menu_item_identities")
}

model MenuItemFeature {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId        String   @map("menu_item_id") @db.Uuid
  itemIdentityKey   String   @map("item_identity_key") @db.VarChar(120)
  officeLocationId  String   @map("office_location_id") @db.Uuid
  tag               String   @db.VarChar(60)
  provenance        String   @db.VarChar(10)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, tag])
  @@index([itemIdentityKey, officeLocationId])
  @@map("menu_item_features")
}

model Poll {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeLocationId       String   @map("office_location_id") @db.Uuid
  createdBy              String?  @map("created_by") @db.VarChar(255)
  description            String   @db.VarChar(120)
  status                 String   @db.VarChar(20)
  startedAt              DateTime @map("started_at") @db.Timestamptz()
  endsAt                 DateTime @map("ends_at") @db.Timestamptz()
  endedPrematurely       Boolean  @default(false) @map("ended_prematurely")
  winnerMenuId           String?  @map("winner_menu_id") @db.Uuid
  winnerMenuName         String?  @map("winner_menu_name") @db.VarChar(60)
  winnerSelectedRandomly Boolean @default(false) @map("winner_selected_randomly")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz()

  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)
  winnerMenu     Menu?          @relation("WinnerMenu", fields: [winnerMenuId], references: [id], onDelete: SetNull)
  votes          PollVote[]
  excludedMenus  PollExcludedMenu[]
  foodSelections FoodSelection[]
  mealRecommendationImpressions MealRecommendationImpression[]

  @@index([officeLocationId, status])
  @@map("polls")
}

model PollVote {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pollId   String   @map("poll_id") @db.Uuid
  menuId   String   @map("menu_id") @db.Uuid
  menuName String   @map("menu_name") @db.VarChar(60)
  nickname String   @db.VarChar(255)
  actorKey String?  @map("actor_key") @db.VarChar(255)
  actorEmail String? @map("actor_email") @db.VarChar(255)
  displayNameSnapshot String? @map("display_name_snapshot") @db.VarChar(255)
  castAt   DateTime @default(now()) @map("cast_at") @db.Timestamptz()

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([pollId, menuId, actorKey])
  @@map("poll_votes")
}

model FoodSelection {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeLocationId String    @map("office_location_id") @db.Uuid
  createdBy        String?   @map("created_by") @db.VarChar(255)
  pollId           String    @map("poll_id") @db.Uuid
  menuId           String?   @map("menu_id") @db.Uuid
  menuName         String    @map("menu_name") @db.VarChar(60)
  status           String    @db.VarChar(20)
  startedAt        DateTime  @map("started_at") @db.Timestamptz()
  endsAt           DateTime  @map("ends_at") @db.Timestamptz()
  orderPlacedAt    DateTime? @map("order_placed_at") @db.Timestamptz()
  orderPlacedBy    String?   @map("order_placed_by") @db.VarChar(255)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz()
  etaMinutes       Int?      @map("eta_minutes")
  etaSetAt         DateTime? @map("eta_set_at") @db.Timestamptz()
  deliveryDueAt    DateTime? @map("delivery_due_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)
  poll           Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  menu           Menu?          @relation(fields: [menuId], references: [id], onDelete: SetNull)
  orders         FoodOrder[]
  recommendationImpressions MealRecommendationImpression[]

  @@index([officeLocationId, status, createdAt])
  @@map("food_selections")
}

model RecommenderModel {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version             Int      @unique
  status              String   @db.VarChar(12)
  paramsJson          Json     @map("params_json")
  factorDim           Int      @map("factor_dim")
  trainedAt           DateTime @map("trained_at") @db.Timestamptz()
  trainingSampleCount Int      @map("training_sample_count")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  mealRecommendationImpressions MealRecommendationImpression[]
  modelEvaluationResults        ModelEvaluationResult[]
  officeRecommenderSettings     OfficeRecommenderSetting[]

  @@index([status])
  @@map("recommender_models")
}

model ModelEvaluationResult {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recommenderModelId  String   @map("recommender_model_id") @db.Uuid
  officeLocationId    String   @map("office_location_id") @db.Uuid
  baselineTop3HitRate Decimal  @map("baseline_top3_hit_rate") @db.Decimal(5, 4)
  modelTop3HitRate    Decimal  @map("model_top3_hit_rate") @db.Decimal(5, 4)
  marginPoints        Decimal  @map("margin_points") @db.Decimal(6, 4)
  sampleCount         Int      @map("sample_count")
  evaluatedAt         DateTime @default(now()) @map("evaluated_at") @db.Timestamptz()

  recommenderModel RecommenderModel @relation(fields: [recommenderModelId], references: [id], onDelete: Cascade)
  officeLocation   OfficeLocation   @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)

  @@index([officeLocationId, recommenderModelId])
  @@map("model_evaluation_results")
}

model OfficeRecommenderSetting {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeLocationId  String   @unique @map("office_location_id") @db.Uuid
  safeMode          String   @default("baseline") @map("safe_mode") @db.VarChar(10)
  activeModelId     String?  @map("active_model_id") @db.Uuid
  exploreEnabled    Boolean  @default(true) @map("explore_enabled")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)
  activeModel    RecommenderModel? @relation(fields: [activeModelId], references: [id], onDelete: SetNull)

  @@map("office_recommender_settings")
}

model FoodOrder {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  selectionId     String    @map("selection_id") @db.Uuid
  nickname        String    @db.VarChar(255)
  actorKey        String?   @map("actor_key") @db.VarChar(255)
  actorEmail      String?   @map("actor_email") @db.VarChar(255)
  displayNameSnapshot String? @map("display_name_snapshot") @db.VarChar(255)
  itemId          String?   @map("item_id") @db.Uuid
  itemName        String    @map("item_name") @db.VarChar(80)
  notes           String?   @db.VarChar(200)
  feedbackComment String?   @map("feedback_comment") @db.VarChar(300)
  processed       Boolean   @default(false)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz()
  delivered       Boolean   @default(false)
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz()
  rating          Int?
  ratedAt         DateTime? @map("rated_at") @db.Timestamptz()
  orderedAt       DateTime  @default(now()) @map("ordered_at") @db.Timestamptz()

  selection FoodSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  item      MenuItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("food_orders")
}

model PollExcludedMenu {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pollId   String   @map("poll_id") @db.Uuid
  menuId   String   @map("menu_id") @db.Uuid
  menuName String   @map("menu_name") @db.VarChar(60)
  reason   String   @db.VarChar(240)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@unique([pollId, menuId])
  @@map("poll_excluded_menus")
}

model LocalAuthUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("local_auth_users")
}

model AuthAccessUser {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String          @unique @db.VarChar(255)
  displayName      String?         @map("display_name") @db.VarChar(255)
  displayNameSource String?        @map("display_name_source") @db.VarChar(20)
  sessionVersion   Int             @default(0) @map("session_version")
  approved         Boolean         @default(false)
  isAdmin          Boolean         @default(false) @map("is_admin")
  blocked          Boolean         @default(false)
  officeLocationId String?         @map("office_location_id") @db.Uuid
  requestedAt      DateTime        @default(now()) @map("requested_at") @db.Timestamptz()
  approvedAt       DateTime?       @map("approved_at") @db.Timestamptz()
  blockedAt        DateTime?       @map("blocked_at") @db.Timestamptz()
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  officeLocation OfficeLocation? @relation(fields: [officeLocationId], references: [id], onDelete: SetNull)
  officeMemberships AuthAccessUserOffice[]

  @@map("auth_access_users")
}

model AuthAccessUserOffice {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authAccessUserId String          @map("auth_access_user_id") @db.Uuid
  officeLocationId String          @map("office_location_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  authAccessUser AuthAccessUser @relation(fields: [authAccessUserId], references: [id], onDelete: Cascade)
  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)

  @@unique([authAccessUserId, officeLocationId])
  @@index([officeLocationId])
  @@map("auth_access_user_offices")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event      String   @db.VarChar(80)
  actorEmail String?  @map("actor_email") @db.VarChar(255)
  targetType String   @map("target_type") @db.VarChar(40)
  targetId   String   @map("target_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([targetType, targetId], map: "audit_logs_target_idx")
  @@map("audit_logs")
}

model AuthAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event       String   @db.VarChar(80)
  actorEmail  String?  @map("actor_email") @db.VarChar(255)
  targetEmail String?  @map("target_email") @db.VarChar(255)
  targetType  String   @default("auth_user") @map("target_type") @db.VarChar(40)
  field       String?  @db.VarChar(80)
  oldValue    String?  @map("old_value") @db.Text
  newValue    String?  @map("new_value") @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([targetEmail, createdAt], map: "auth_audit_logs_target_email_idx")
  @@index([event, createdAt], map: "auth_audit_logs_event_idx")
  @@map("auth_audit_logs")
}

model UserPreference {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userKey         String   @unique @map("user_key") @db.VarChar(255)
  allergiesJson   Json     @default("[]") @map("allergies_json")
  dislikesJson    Json     @default("[]") @map("dislikes_json")
  explorationRate Float    @default(0.5) @map("exploration_rate")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("user_preferences")
}

model UserAnticipatedLike {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorKey            String   @map("actor_key") @db.VarChar(255)
  actorEmail          String?  @map("actor_email") @db.VarChar(255)
  displayNameSnapshot String?  @map("display_name_snapshot") @db.VarChar(255)
  officeLocationId    String   @map("office_location_id") @db.Uuid
  itemIdentityKey     String   @map("item_identity_key") @db.VarChar(120)
  itemNameSnapshot    String   @map("item_name_snapshot") @db.VarChar(80)
  sentiment           String   @db.VarChar(10)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)

  @@unique([actorKey, officeLocationId, itemIdentityKey])
  @@map("user_anticipated_likes")
}

model UserMenuDefaultPreference {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userKey                String   @map("user_key") @db.VarChar(255)
  menuId                 String   @map("menu_id") @db.Uuid
  itemId                 String   @map("item_id") @db.Uuid
  defaultComment         String?  @map("default_comment") @db.VarChar(200)
  allowOrganizerFallback Boolean  @default(false) @map("allow_organizer_fallback")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userKey, menuId])
  @@map("user_menu_default_preferences")
}

model MealRecommendationImpression {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  foodSelectionId     String?  @map("food_selection_id") @db.Uuid
  pollId              String?  @map("poll_id") @db.Uuid
  officeLocationId    String   @map("office_location_id") @db.Uuid
  actorKey            String   @map("actor_key") @db.VarChar(255)
  actorEmail          String?  @map("actor_email") @db.VarChar(255)
  displayNameSnapshot String?  @map("display_name_snapshot") @db.VarChar(255)
  source              String   @db.VarChar(40)
  provider            String?  @db.VarChar(60)
  recommenderModelId  String?  @map("recommender_model_id") @db.Uuid
  recommendedAt       DateTime @map("recommended_at") @db.Timestamptz()
  inputSummaryJson    Json     @map("input_summary_json")
  itemsJson           Json     @map("items_json")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  foodSelection  FoodSelection? @relation(fields: [foodSelectionId], references: [id], onDelete: Cascade)
  poll           Poll?          @relation(fields: [pollId], references: [id], onDelete: SetNull)
  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)
  recommenderModel RecommenderModel? @relation(fields: [recommenderModelId], references: [id], onDelete: SetNull)

  @@index([foodSelectionId, actorKey])
  @@index([pollId, actorKey])
  @@index([officeLocationId, actorKey, recommendedAt])
  @@map("meal_recommendation_impressions")
}

model ShoppingListItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeLocationId String @map("office_location_id") @db.Uuid
  name        String   @db.VarChar(160)
  requestedBy String   @map("requested_by") @db.VarChar(255)
  bought      Boolean  @default(false)
  boughtBy    String?  @map("bought_by") @db.VarChar(255)
  boughtAt    DateTime? @map("bought_at") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)

  @@index([officeLocationId, bought, createdAt])
  @@map("shopping_list_items")
}
