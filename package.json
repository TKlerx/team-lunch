{
  "name": "team-lunch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "dev": "pnpm run ports:check && concurrently \"pnpm:dev:server\" \"pnpm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:server:sqlite": "node ./scripts/dev-server-sqlite.mjs",
    "dev:client": "vite",
    "ports:check": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-port-blockers.ps1",
    "ports:check:ci": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-port-blockers.ps1 -NonInteractive",
    "db:test:up": "docker compose --profile test up -d --wait db-test",
    "db:test:down": "docker compose --profile test rm -sfv db-test",
    "preinstall": "only-allow pnpm",
    "prebuild": "node ./scripts/prisma-generate-safe.mjs",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/server/index.js",
    "pretypecheck": "node ./scripts/prisma-generate-safe.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "architecture": "depcruise --config .dependency-cruiser.cjs src",
    "complexity": "node scripts/check-complexity-baseline.mjs",
    "complexity:update": "node scripts/check-complexity-baseline.mjs --update",
    "function-size": "node scripts/check-function-size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "continuity:update": "node scripts/update-continuity.js",
    "semgrep": "node -e \"const p=require('path').join('.venv',process.platform==='win32'?'Scripts':'bin',process.platform==='win32'?'semgrep.exe':'semgrep');require('child_process').execFileSync(p,['scan','--config','auto','--error','.'],{stdio:'inherit'})\"",
    "pretest": "node ./scripts/prisma-generate-safe.mjs",
    "test": "vitest run",
    "precoverage": "node ./scripts/prisma-generate-safe.mjs",
    "coverage": "vitest run --coverage",
    "pretest:server": "node ./scripts/prisma-generate-safe.mjs",
    "test:server": "vitest run --project server",
    "test:server:sqlite": "node ./scripts/test-server-sqlite.mjs",
    "test:client": "vitest run --project client",
    "test:e2e": "playwright test",
    "duplication": "node scripts/check-duplication.mjs",
    "validate:precommit": "pwsh -NoProfile -ExecutionPolicy Bypass -File validate.ps1 precommit",
    "validate:prepush": "pwsh -NoProfile -ExecutionPolicy Bypass -File validate.ps1 prepush",
    "validate:full": "pwsh -NoProfile -ExecutionPolicy Bypass -File validate.ps1 full",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "auth:seed": "tsx scripts/auth-seed.ts",
    "prisma:generate:sqlite": "prisma generate --schema prisma/schema.sqlite.prisma",
    "prisma:push:sqlite": "prisma db push --schema prisma/schema.sqlite.prisma",
    "deploy": "sh ./scripts/deploy.sh",
    "validate": "pwsh -NoProfile -File ./validate.ps1 all"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^9.1.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@wlearn/xlearn": "0.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "jose": "^6.2.2",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.21.0",
    "eslint-plugin-sonarjs": "^4.0.0",
    "jscpd": "^4.0.8",
    "jsdom": "^26.0.0",
    "only-allow": "1.2.2",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.2",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "overrides": {
      "effect": "3.21.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@swc/core",
      "sharp"
    ]
  },
  "description": "Team Lunch is a collaborative lunch coordination app for teams. It helps a group pick a place to eat, collect everyone's order, and track delivery status in real time.",
  "main": "eslint.config.js",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TKlerx/team-lunch.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TKlerx/team-lunch/issues"
  },
  "homepage": "https://github.com/TKlerx/team-lunch#readme"
}
