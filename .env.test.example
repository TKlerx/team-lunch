# Test-only environment overrides. Copy to `.env.test` (gitignored) to run the
# test suite against the dedicated, isolated Postgres instead of your dev DB:
#
#   cp .env.test.example .env.test
#   pnpm db:test:up      # start the dedicated test Postgres (docker compose db-test)
#   pnpm test            # server integration tests run against teamlunch_test
#   pnpm test:e2e        # Playwright e2e (once specs exist)
#   pnpm db:test:down    # stop + discard the test DB
#
# When TEST_DATABASE_URL is set, the suite targets THIS database and will NOT
# silently fall back to SQLite — if it's unreachable, tests fail loudly. So
# `pnpm db:test:up` must be running before you commit/push (the git hooks run
# the suite). Remove `.env.test` to use the DATABASE_URL / SQLite fallback.
#
# Host port is TEST_DB_PORT (default 55434). Change both if 55434 is taken.
TEST_DATABASE_URL="postgresql://teamlunch:teamlunch@localhost:55434/teamlunch_test?schema=team_lunch_test"
